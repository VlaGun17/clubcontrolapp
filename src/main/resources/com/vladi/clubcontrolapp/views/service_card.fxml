<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="300.0" spacing="10.0"
  style="-fx-background-color: #2a2a32; -fx-background-radius: 10; -fx-border-color: #444; -fx-border-radius: 10;"
  xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
  </padding>

  <HBox alignment="CENTER_LEFT" spacing="10.0">
    <Label fx:id="nameLabel" text="Назва послуги" textFill="#4cc9f0">
      <font><Font name="System Bold" size="18.0" /></font>
    </Label>
    <Region HBox.hgrow="ALWAYS" />
    <Label style="-fx-background-color: #7209b7; -fx-text-fill: white; -fx-background-radius: 5;" text="ПОСЛУГА">
      <padding><Insets bottom="2.0" left="5.0" right="5.0" top="2.0" /></padding>
    </Label>
  </HBox>

  <Separator opacity="0.1" />

  <GridPane vgap="5.0">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
    </columnConstraints>
    <rowConstraints>
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>

    <Label text="Вартість:" textFill="#ccc" GridPane.rowIndex="0" />
    <Label fx:id="priceLabel" text="0.00 ₴" textFill="#4caf50" GridPane.columnIndex="1" GridPane.rowIndex="0">
      <font><Font name="System Bold" size="16.0" /></font>
    </Label>
  </GridPane>

  <HBox spacing="10.0" alignment="CENTER_RIGHT">
    <Button fx:id="buyServiceBtn" text="Придбати" style="-fx-background-color: transparent;
      -fx-border-color: #4cc9f0; -fx-text-fill: #4cc9f0; -fx-border-radius: 5;" />
  </HBox>
</VBox>