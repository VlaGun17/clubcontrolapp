<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:controller="com.vladi.clubcontrolapp.presentation.controller.LoginController" alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="500.0"
  style="-fx-background-color: #1e1e24;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

  <padding>
    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
  </padding>

  <Label text="CLUB CONTROL" textFill="#4cc9f0">
    <font>
      <Font name="System Bold" size="28.0" />
    </font>
    <VBox.margin>
      <Insets bottom="20.0" />
    </VBox.margin>
  </Label>

  <Label text="Вхід для адміністратора" textFill="WHITE" />

  <TextField fx:id="loginField" promptText="Логін"
    style="-fx-background-color: #2a2a32; -fx-text-fill: white; -fx-prompt-text-fill: #888; -fx-background-radius: 5;"/>

  <PasswordField fx:id="passwordField" promptText="Пароль"
    style="-fx-background-color: #2a2a32; -fx-text-fill: white; -fx-prompt-text-fill: #888; -fx-background-radius: 5;"/>

  <Button onAction="#handleLogin" prefWidth="Infinity" text="УВІЙТИ"
    style="-fx-background-color: #7209b7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
    <padding>
      <Insets bottom="10.0" top="10.0" />
    </padding>
  </Button>

  <Label fx:id="errorLabel" textFill="#f44336" wrapText="true" />

  <Hyperlink onAction="#handleShowRegistration" text="Зареєструвати нового адміна" textFill="#4cc9f0" />

</VBox>