<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" prefWidth="350.0" style="-fx-background-color: #2a2a32; -fx-padding: 25;"
  xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.vladi.clubcontrolapp.presentation.controller.ManageComputerController">

  <HBox alignment="CENTER_LEFT">
    <Label text="КЕРУВАННЯ ПК" textFill="#4cc9f0">
      <font><Font name="System Bold" size="20.0" /></font>
    </Label>
    <Region HBox.hgrow="ALWAYS" />
    <Button text="✕" onAction="#handleClose"
      style="-fx-background-color: transparent; -fx-text-fill: #ccc; -fx-font-size: 18px; -fx-cursor: hand;" />
  </HBox>

  <Separator opacity="0.1" />

  <VBox spacing="5.0">
    <Label text="Обраний комп'ютер:" textFill="#ccc" />
    <Label fx:id="pcNameLabel" text="PC-00" textFill="WHITE">
      <font><Font name="System Bold" size="24.0" /></font>
    </Label>
    <Label fx:id="statusLabel" text="СТАТУС" textFill="#4caf50" />
  </VBox>

  <Separator opacity="0.1" />

  <VBox spacing="15.0">
    <Button fx:id="startSessionBtn" text="Розпочати сесію" onAction="#handleShowSessionForm"
      prefWidth="Infinity" prefHeight="40.0"
      style="-fx-background-color: #7209b7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />

    <VBox fx:id="sessionFormBox" spacing="10.0" visible="false" managed="false"
      style="-fx-background-color: #1e1e24; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #444; -fx-border-radius: 5;">

      <Label text="Налаштування сесії:" textFill="#4cc9f0" />

      <ComboBox fx:id="clientComboBox" promptText="Оберіть клієнта..." prefWidth="Infinity"
        style="-fx-background-color: #2a2a32; -fx-text-fill: white;" />

      <ComboBox fx:id="tariffComboBox" promptText="Оберіть тариф" prefWidth="Infinity"
        style="-fx-background-color: #2a2a32; -fx-text-fill: white;" />

      <TextField fx:id="durationField" promptText="Кількість годин (наприклад: 2.5)"
        style="-fx-background-color: #2a2a32; -fx-text-fill: white;" />

      <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Скасувати" onAction="#handleCancelSessionForm"
          style="-fx-background-color: transparent; -fx-text-fill: #ccc; -fx-cursor: hand;" />
        <Button text="Підтвердити" onAction="#handleConfirmSession"
          style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
      </HBox>
    </VBox>

    <Button fx:id="endSessionBtn" text="Завершити сесію" onAction="#handleShowEndSession"
      prefWidth="Infinity" prefHeight="40.0"
      style="-fx-background-color: transparent; -fx-border-color: #f44336; -fx-text-fill: #f44336; -fx-border-radius: 5; -fx-font-weight: bold;" />

    <VBox fx:id="endSessionFormBox" spacing="10.0" visible="false" managed="false"
      style="-fx-background-color: #1e1e24; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #f44336; -fx-border-radius: 5;">

      <Label text="Завершення сесії та оплата:" textFill="#f44336" style="-fx-font-weight: bold;" />

      <HBox spacing="5.0" alignment="CENTER_LEFT">
        <Label text="Сума до сплати:" textFill="#ccc" />
        <Label fx:id="totalCostLabel" text="0.00 ₴" textFill="#4caf50" style="-fx-font-weight: bold; -fx-font-size: 14.0;" />
      </HBox>

      <ComboBox fx:id="paymentMethodComboBox" promptText="Оберіть метод оплати" prefWidth="Infinity"
        style="-fx-background-color: #2a2a32; -fx-text-fill: white;" />

      <Label fx:id="errorLabel" textFill="#f44336" wrapText="true" />

      <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Скасувати" onAction="#handleCancelEndSessionForm"
          style="-fx-background-color: transparent; -fx-text-fill: #ccc; -fx-cursor: hand;" />
        <Button text="Оплатити та закрити" onAction="#handleConfirmEndSession"
          style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />
      </HBox>
    </VBox>
  </VBox>

</VBox>