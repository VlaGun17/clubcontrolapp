<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" prefWidth="350.0" style="-fx-background-color: #2a2a32; -fx-padding: 25;"
  xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.vladi.clubcontrolapp.presentation.controller.ManageTariffController">

  <HBox alignment="CENTER_LEFT">
    <Label text="КЕРУВАННЯ ТАРИФОМ" textFill="#4cc9f0">
      <font><Font name="System Bold" size="20.0" /></font>
    </Label>
    <Region HBox.hgrow="ALWAYS" />
    <Button text="✕" onAction="#handleClose"
      style="-fx-background-color: transparent; -fx-text-fill: #ccc; -fx-font-size: 18px; -fx-cursor: hand;" />
  </HBox>

  <Separator opacity="0.1" />

  <VBox spacing="5.0">
    <Label text="Поточний тариф:" textFill="#ccc" />
    <Label fx:id="tariffTitleLabel" text="STANDARD" textFill="WHITE">
      <font><Font name="System Bold" size="24.0" /></font>
    </Label>
    <Label fx:id="currentPriceLabel" text="60.00 ₴ / год" textFill="#4caf50" />
  </VBox>

  <Separator opacity="0.1" />

  <VBox fx:id="editTariffForm" spacing="15.0" style="-fx-background-color: #1e1e24; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #444; -fx-border-radius: 5;">

    <Label text="Редагування параметрів:" textFill="#4cc9f0" style="-fx-font-weight: bold;" />

    <VBox spacing="5.0">
      <Label text="Назва тарифу:" textFill="#ccc" style="-fx-font-size: 12.0;" />
      <TextField fx:id="nameField" promptText="Наприклад: VIP Room"
        style="-fx-background-color: #2a2a32; -fx-text-fill: white; -fx-background-radius: 5; -fx-border-color: #444;" />
    </VBox>

    <VBox spacing="5.0">
      <Label text="Ціна за годину (₴):" textFill="#ccc" style="-fx-font-size: 12.0;" />
      <TextField fx:id="priceField" promptText="Наприклад: 85.00"
        style="-fx-background-color: #2a2a32; -fx-text-fill: white; -fx-background-radius: 5; -fx-border-color: #444;" />
    </VBox>

    <CheckBox fx:id="isNightTariffCheckBox" text="Нічний тариф" textFill="WHITE" style="-fx-cursor: hand;" />

    <Label fx:id="errorLabel" text="" textFill="#f44336" wrapText="true" style="-fx-font-size: 13.0;" />

    <HBox spacing="10.0" alignment="CENTER">
      <Button text="Зберегти зміни" onAction="#handleConfirmUpdate" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="35.0"
        style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;" />
      <Button text="Скасувати" onAction="#handleCancel" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="35.0"
        style="-fx-background-color: transparent; -fx-border-color: #ccc; -fx-text-fill: white; -fx-border-radius: 5; -fx-cursor: hand;" />
    </HBox>
  </VBox>

</VBox>